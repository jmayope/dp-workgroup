        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Estilo de cajas\n    classDef caja fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000;\n\n    %% Nivel 1: Alta Dirección\n    DE[\&quot;DIRECCION&lt;br/&gt;EJECUTIVA\&quot;] ::: caja\n\n    %% Nivel de Control\n    OCI[\&quot;ORGANO DE CONTROL&lt;br/&gt;INSTITUCIONAL\&quot;] ::: caja\n\n    %% Nivel Asesor y de Apoyo (Oficinas Principales)\n    OA[\&quot;OFICINA DE&lt;br/&gt;ADMINISTRACION\&quot;] ::: caja\n    ORH[\&quot;OFICINA DE&lt;br/&gt;RECURSOS&lt;br/&gt;HUMANOS\&quot;] ::: caja\n    OPPM[\&quot;OFICINA DE PLANEAMIENTO,&lt;br/&gt;PRESUPUESTO Y&lt;br/&gt;MODERNIZACION\&quot;] ::: caja\n    OAJ[\&quot;OFICINA DE&lt;br/&gt;ASESORIA&lt;br/&gt;JURIDICA\&quot;] ::: caja\n\n    %% Unidades dependientes de Administración\n    ULog[\&quot;UNIDAD DE&lt;br/&gt;LOGISTICA\&quot;] ::: caja\n    UEco[\&quot;UNIDAD DE&lt;br/&gt;ECONOMIA\&quot;] ::: caja\n    UPat[\&quot;UNIDAD DE&lt;br/&gt;PATRIMONIO\&quot;] ::: caja\n    UTes[\&quot;UNIDAD DE&lt;br/&gt;TESORERIA\&quot;] ::: caja\n\n    %% Unidades de Apoyo Técnico\n    USeg[\&quot;UNIDAD DE&lt;br/&gt;SEGUROS\&quot;] ::: caja\n    UTec[\&quot;UNIDAD DE&lt;br/&gt;TECNOLOGIAS\&quot;] ::: caja\n    UMID[\&quot;UNIDAD DE&lt;br/&gt;MEDICAMENTOS&lt;br/&gt;, INSUMOS Y&lt;br/&gt;DROGAS\&quot;] ::: caja\n\n    %% Oficinas de Línea / Salud\n    OSP[\&quot;OFICINA DE&lt;br/&gt;SALUD PUBLICA\&quot;] ::: caja\n    OPSE[\&quot;OFICINA DE&lt;br/&gt;PRESTACIONES&lt;br/&gt;DE SALUD Y&lt;br/&gt;EPIDEMIOLOGIA\&quot;] ::: caja\n\n    %% Microredes\n    MR_ET[\&quot;MICRORED&lt;br/&gt;EL TAMBO\&quot;] ::: caja\n    MR_LL[\&quot;MICRORED&lt;br/&gt;LA LIBERTAD\&quot;] ::: caja\n    MR_PAR[\&quot;MICRORED&lt;br/&gt;PARIAHUANCA\&quot;] ::: caja\n    MR_CHI[\&quot;MICRORED&lt;br/&gt;CHILCA\&quot;] ::: caja\n    MR_HUA[\&quot;MICRORED&lt;br/&gt;HUAYUCACHI\&quot;] ::: caja\n    MR_SAP[\&quot;MICRORED&lt;br/&gt;SAPALLANGA\&quot;] ::: caja\n    MR_SAC[\&quot;MICRORED&lt;br/&gt;SAN AGUSTIN&lt;br/&gt;DE CAJAS\&quot;] ::: caja\n    MR_PIL[\&quot;MICRORED&lt;br/&gt;PILCOMAYO\&quot;] ::: caja\n\n    %% Relaciones\n    DE --- OCI\n    DE --- OA\n    DE --- ORH\n    DE --- OPPM\n    DE --- OAJ\n\n    OA --- ULog\n    OA --- UEco\n    ULog --- UPat\n    UEco --- UTes\n\n    DE --- USeg\n    DE --- UTec\n    DE --- UMID\n\n    DE --- OSP\n    DE --- OPSE\n\n    DE --- MR_ET\n    DE --- MR_LL\n    DE --- MR_PAR\n    DE --- MR_CHI\n    DE --- MR_HUA\n    DE --- MR_SAP\n    DE --- MR_SAC\n    DE --- MR_PIL&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dM5bB40umds85V54rdzk-1">
